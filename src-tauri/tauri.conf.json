{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanMic",
  "version": "0.1.0",
  "identifier": "com.cleanmic.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CleanMic",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#171411"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
